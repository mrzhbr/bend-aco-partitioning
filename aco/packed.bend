      update12_15(heads, factor, weight, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11)

def block_update12(block: Block12, +heads: List<&2, F.Head>, +factor: F32) -> Block12:

  match block:
    case B12{r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15}:

      a0 = apply12_0(r0, heads, factor)

      a1 = apply12_1(r1, heads, factor)

      a2 = apply12_2(r2, heads, factor)

      a3 = apply12_3(r3, heads, factor)

      a4 = apply12_4(r4, heads, factor)

      a5 = apply12_5(r5, heads, factor)

      a6 = apply12_6(r6, heads, factor)

      a7 = apply12_7(r7, heads, factor)

      a8 = apply12_8(r8, heads, factor)

      a9 = apply12_9(r9, heads, factor)

      a10 = apply12_10(r10, heads, factor)

      a11 = apply12_11(r11, heads, factor)

      a12 = apply12_12(r12, heads, factor)

      a13 = apply12_13(r13, heads, factor)

      a14 = apply12_14(r14, heads, factor)

      a15 = apply12_15(r15, heads, factor)

      B12{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}

def apply_heads12(block: Block12, state: List<&2, F.Head> & List<&2, F.Trail>, factor: F32) -> Block12 & List<&2, F.Trail>:

  match state:
    case Tuple{heads, tails}:
      (block_update12(block, heads, factor), tails)

def step12(block: Block12, trails: List<&2, F.Trail>, factor: F32) -> Block12 & List<&2, F.Trail>:

  apply_heads12(block, F.advance(trails, [], []), factor)

def updates_loop12(table: List<&2, Block12>, state: Block12 & List<&2, F.Trail>, acc: List<&2, Block12>, +factor: F32) -> List<&2, Block12>:

  match table state:
    case Nil{} Tuple{block, trails}:
      List.reverse(&2, Block12, block <> acc)

    case Con{next, rest} Tuple{block, trails}:
      updates_loop12(rest, step12(next, trails, factor), block <> acc, factor)

def updates_start12(table: List<&2, Block12>, trails: List<&2, F.Trail>, +factor: F32) -> List<&2, Block12>:

  match table:
    case Nil{}:
      []
    case Con{block, rest}:

      updates_loop12(rest, step12(block, trails, factor), [], factor)

def updates12(+forks: Nat, +count: U32, +table: List<&2, Block12>, +trails: List<&2, F.Trail>, +factor: F32) -> List<&2, Block12>:

  match forks:
    case 0n:
      updates_start12(table, trails, factor)

    case 1n+rest:
      +half = (count / 2 : U32)
      +cut = U32.to_nat(half)

      a b = updates12(rest, half, List.take(&2, Block12, table, cut), F.left_trails(trails, cut), factor)

        updates12(rest, (count - half : U32), List.drop(&2, Block12, table, cut), F.right_trails(trails, cut), factor)

      List.append(&2, Block12, a, b)

def iterate12(left: Nat, +items: U32, +blocks: U32, +ants: U32, +seed: U32, +generation: U32,
  +forks: Nat, +factor: F32, +table: List<&2, Block12>, +winner: F.Ant, final: U32) -> A.Outcome:

  match left:
    case 0n:
      F.outcome(winner, items, final, (generation * ants : U32))
    case 1n+rest:

      +population = population12(forks, 0, ants, table, seed, generation)

      +best = F.best(population, F.Ant{[], 4294967295})

      updated = updates12(forks, blocks, table, F.trails(population), factor)

      iterate12(rest, items, blocks, ants, seed, (generation + 1 : U32), forks, factor,

        updated, F.better(winner, best), F.fitness(best))

def run12(+problem: U32, +items: U32, +ants: U32, evaporation: F32, +budget: U32, +seed: U32,
  forks: Nat) -> A.Outcome:

  +blocks = ((items + 15) / 16 : U32)
  generations = ((budget + ants - 1) / ants : U32)

  iterate12(U32.to_nat(generations), items, blocks, ants, seed, 0, forks, (1.0 - evaporation : F32),

    table12(U32.to_nat(blocks), 0, problem, items, seed), F.Ant{[], 4294967295}, 4294967295)
# ---- 40 bins: packed scalar rows, sixteen-item path blocks ----

type Row40 is Data:

  R40{weight: U32, m0: F32, m1: F32, m2: F32, m3: F32, m4: F32, m5: F32, m6: F32, m7: F32, m8: F32, m9: F32, m10: F32, m11: F32, m12: F32, m13: F32, m14: F32, m15: F32, m16: F32, m17: F32, m18: F32, m19: F32, m20: F32, m21: F32, m22: F32, m23: F32, m24: F32, m25: F32, m26: F32, m27: F32, m28: F32, m29: F32, m30: F32, m31: F32, m32: F32, m33: F32, m34: F32, m35: F32, m36: F32, m37: F32, m38: F32, m39: F32, s0_32: F32, s0_16: F32, s0_8: F32, s0_4: F32, s0_2: F32, s4_2: F32, s8_4: F32, s8_2: F32, s12_2: F32, s16_8: F32, s16_4: F32, s16_2: F32, s20_2: F32, s24_4: F32, s24_2: F32, s28_2: F32, s32_8: F32, s32_4: F32, s32_2: F32, s36_2: F32, s0_64: F32}

type Block40 is Data:

  B40{r0: Row40, r1: Row40, r2: Row40, r3: Row40, r4: Row40, r5: Row40, r6: Row40, r7: Row40, r8: Row40, r9: Row40, r10: Row40, r11: Row40, r12: Row40, r13: Row40, r14: Row40, r15: Row40}

def make40(weight: U32, +m0: F32, +m1: F32, +m2: F32, +m3: F32, +m4: F32,
  +m5: F32, +m6: F32, +m7: F32, +m8: F32, +m9: F32, +m10: F32,
  +m11: F32, +m12: F32, +m13: F32, +m14: F32, +m15: F32, +m16: F32,
  +m17: F32, +m18: F32, +m19: F32, +m20: F32, +m21: F32, +m22: F32,
  +m23: F32, +m24: F32, +m25: F32, +m26: F32, +m27: F32, +m28: F32,
  +m29: F32, +m30: F32, +m31: F32, +m32: F32, +m33: F32, +m34: F32,
  +m35: F32, +m36: F32, +m37: F32, +m38: F32, +m39: F32) -> Row40:

  +s0_2 = (m0 + m1 : F32)

  +s2_2 = (m2 + m3 : F32)

  +s0_4 = (s0_2 + s2_2 : F32)

  +s4_2 = (m4 + m5 : F32)

  +s6_2 = (m6 + m7 : F32)

  +s4_4 = (s4_2 + s6_2 : F32)

  +s0_8 = (s0_4 + s4_4 : F32)

  +s8_2 = (m8 + m9 : F32)

  +s10_2 = (m10 + m11 : F32)

  +s8_4 = (s8_2 + s10_2 : F32)

  +s12_2 = (m12 + m13 : F32)

  +s14_2 = (m14 + m15 : F32)

  +s12_4 = (s12_2 + s14_2 : F32)

  +s8_8 = (s8_4 + s12_4 : F32)

  +s0_16 = (s0_8 + s8_8 : F32)

  +s16_2 = (m16 + m17 : F32)

  +s18_2 = (m18 + m19 : F32)

  +s16_4 = (s16_2 + s18_2 : F32)

  +s20_2 = (m20 + m21 : F32)

  +s22_2 = (m22 + m23 : F32)

  +s20_4 = (s20_2 + s22_2 : F32)

  +s16_8 = (s16_4 + s20_4 : F32)

  +s24_2 = (m24 + m25 : F32)

  +s26_2 = (m26 + m27 : F32)

  +s24_4 = (s24_2 + s26_2 : F32)

  +s28_2 = (m28 + m29 : F32)

  +s30_2 = (m30 + m31 : F32)

  +s28_4 = (s28_2 + s30_2 : F32)

  +s24_8 = (s24_4 + s28_4 : F32)

  +s16_16 = (s16_8 + s24_8 : F32)

  +s0_32 = (s0_16 + s16_16 : F32)

  +s32_2 = (m32 + m33 : F32)

  +s34_2 = (m34 + m35 : F32)

  +s32_4 = (s32_2 + s34_2 : F32)

  +s36_2 = (m36 + m37 : F32)

  +s38_2 = (m38 + m39 : F32)

  +s36_4 = (s36_2 + s38_2 : F32)

  +s32_8 = (s32_4 + s36_4 : F32)

  +s0_64 = (s0_32 + s32_8 : F32)

  R40{weight, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15, m16, m17, m18, m19, m20, m21, m22, m23, m24, m25, m26, m27, m28, m29, m30, m31, m32, m33, m34, m35, m36, m37, m38, m39, s0_32, s0_16, s0_8, s0_4, s0_2, s4_2, s8_4, s8_2, s12_2, s16_8, s16_4, s16_2, s20_2, s24_4, s24_2, s28_2, s32_8, s32_4, s32_2, s36_2, s0_64}

def weight40(row: Row40) -> U32:

  match row:
    case R40{weight, m0, m1, m2, m3, m4, m5, m6, m7, m8, m9, m10, m11, m12, m13, m14, m15, m16, m17, m18, m19, m20, m21, m22, m23, m24, m25, m26, m27, m28, m29, m30, m31, m32, m33, m34, m35, m36, m37, m38, m39, s0_32, s0_16, s0_8, s0_4, s0_2, s4_2, s8_4, s8_2, s12_2, s16_8, s16_4, s16_2, s20_2, s24_4, s24_2, s28_2, s32_8, s32_4, s32_2, s36_2, s0_64}:
      weight

def new40(+problem: U32, +item: U32, +items: U32, +seed: U32) -> Row40:

  weight = F.word((item < items : U32), A.weight(problem, (item + 1 : U32)), 0)

