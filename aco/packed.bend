def block_update40(block: Block40, +heads: List<&2, F.Head>, +factor: F32) -> Block40:

  match block:
    case B40{r0, r1, r2, r3, r4, r5, r6, r7, r8, r9, r10, r11, r12, r13, r14, r15}:

      a0 = apply40_0(r0, heads, factor)

      a1 = apply40_1(r1, heads, factor)

      a2 = apply40_2(r2, heads, factor)

      a3 = apply40_3(r3, heads, factor)

      a4 = apply40_4(r4, heads, factor)

      a5 = apply40_5(r5, heads, factor)

      a6 = apply40_6(r6, heads, factor)

      a7 = apply40_7(r7, heads, factor)

      a8 = apply40_8(r8, heads, factor)

      a9 = apply40_9(r9, heads, factor)

      a10 = apply40_10(r10, heads, factor)

      a11 = apply40_11(r11, heads, factor)

      a12 = apply40_12(r12, heads, factor)

      a13 = apply40_13(r13, heads, factor)

      a14 = apply40_14(r14, heads, factor)

      a15 = apply40_15(r15, heads, factor)

      B40{a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10, a11, a12, a13, a14, a15}

def apply_heads40(block: Block40, state: List<&2, F.Head> & List<&2, F.Trail>, factor: F32) -> Block40 & List<&2, F.Trail>:

  match state:
    case Tuple{heads, tails}:
      (block_update40(block, heads, factor), tails)

def step40(block: Block40, trails: List<&2, F.Trail>, factor: F32) -> Block40 & List<&2, F.Trail>:

  apply_heads40(block, F.advance(trails, [], []), factor)

def updates_loop40(table: List<&2, Block40>, state: Block40 & List<&2, F.Trail>, acc: List<&2, Block40>, +factor: F32) -> List<&2, Block40>:

  match table state:
    case Nil{} Tuple{block, trails}:
      List.reverse(&2, Block40, block <> acc)

    case Con{next, rest} Tuple{block, trails}:
      updates_loop40(rest, step40(next, trails, factor), block <> acc, factor)

def updates_start40(table: List<&2, Block40>, trails: List<&2, F.Trail>, +factor: F32) -> List<&2, Block40>:

  match table:
    case Nil{}:
      []
    case Con{block, rest}:

      updates_loop40(rest, step40(block, trails, factor), [], factor)

def updates40(+forks: Nat, +count: U32, +table: List<&2, Block40>, +trails: List<&2, F.Trail>, +factor: F32) -> List<&2, Block40>:

  match forks:
    case 0n:
      updates_start40(table, trails, factor)

    case 1n+rest:
      +half = (count / 2 : U32)
      +cut = U32.to_nat(half)

      a b = updates40(rest, half, List.take(&2, Block40, table, cut), F.left_trails(trails, cut), factor)

        updates40(rest, (count - half : U32), List.drop(&2, Block40, table, cut), F.right_trails(trails, cut), factor)

      List.append(&2, Block40, a, b)

def iterate40(left: Nat, +items: U32, +blocks: U32, +ants: U32, +seed: U32, +generation: U32,
  +forks: Nat, +factor: F32, +table: List<&2, Block40>, +winner: F.Ant, final: U32) -> A.Outcome:

  match left:
    case 0n:
      F.outcome(winner, items, final, (generation * ants : U32))
    case 1n+rest:

      +population = population40(forks, 0, ants, table, seed, generation)

      +best = F.best(population, F.Ant{[], 4294967295})

      updated = updates40(forks, blocks, table, F.trails(population), factor)

      iterate40(rest, items, blocks, ants, seed, (generation + 1 : U32), forks, factor,

        updated, F.better(winner, best), F.fitness(best))

def run40(+problem: U32, +items: U32, +ants: U32, evaporation: F32, +budget: U32, +seed: U32,
  forks: Nat) -> A.Outcome:

  +blocks = ((items + 15) / 16 : U32)
  generations = ((budget + ants - 1) / ants : U32)

  iterate40(U32.to_nat(generations), items, blocks, ants, seed, 0, forks, (1.0 - evaporation : F32),

    table40(U32.to_nat(blocks), 0, problem, items, seed), F.Ant{[], 4294967295}, 4294967295)
